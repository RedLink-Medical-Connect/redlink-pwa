# ===========================================
# REDLINK - CONFIGURATION ENVIRONNEMENT
# ===========================================

# --- AWS CONFIGURATION ---
VITE_AWS_REGION=eu-west-3
VITE_AWS_APPSYNC_GRAPHQL_ENDPOINT=https://your-appsync-endpoint.appsync-api.eu-west-3.amazonaws.com/graphql
VITE_AWS_APPSYNC_REGION=eu-west-3
VITE_AWS_APPSYNC_AUTH_TYPE=AMAZON_COGNITO_USER_POOLS

# --- COGNITO CONFIGURATION ---
VITE_AWS_COGNITO_IDENTITY_POOL_ID=eu-west-3:your-identity-pool-id
VITE_AWS_COGNITO_REGION=eu-west-3
VITE_AWS_USER_POOLS_ID=eu-west-3_YourPoolId
VITE_AWS_USER_POOLS_WEB_CLIENT_ID=your-client-id

# --- LOCATION SERVICE ---
VITE_AWS_GEO_REGION=eu-west-1
VITE_AWS_GEO_SEARCH_INDEX=placeIndex-dev

# --- API ENDPOINTS ---
VITE_API_STRIPE_ENDPOINT=https://your-api-gateway.execute-api.eu-west-3.amazonaws.com/dev

# --- COMPTES DE TEST (DÉVELOPPEMENT UNIQUEMENT) ---
TEST_VET_EMAIL=test.vet@redlink.app
TEST_VET_PASSWORD=Password123!
TEST_VET_FIRSTNAME=test
TEST_VET_LASTNAME=vet
TEST_VET_RPPS=10000000

TEST_OWNER_EMAIL=test.owner@redlink.app
TEST_OWNER_PASSWORD=Password123!
TEST_OWNER_FIRSTNAME=test
TEST_OWNER_LASTNAME=owner

# --- ENVIRONNEMENT ---
NODE_ENV=development
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0