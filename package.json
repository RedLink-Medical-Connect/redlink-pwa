{
  "name": "redlink-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.0",
    "@stripe/stripe-js": "^8.5.3",
    "@tailwindcss/vite": "^4.1.17",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.1.0",
    "aws-amplify": "^6.15.8",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.0",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.0",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@playwright/test": "^1.57.0",
    "@primevue/auto-import-resolver": "^4.5.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.6.2",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.14"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{js,vue,json,css,md}": [
      "prettier --write"
    ]
  }
}
